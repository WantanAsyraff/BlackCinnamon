# ---------------------------------------------------------------------------
# BlackCinnamon environment template
# Copy to .env and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Web (Next.js) -----------------------------------------------------------
# Public values are exposed to the browser. Do not put secrets here.
WEB_PORT=3000
# Base URL the browser/server uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Server-only override used by Next.js to reach the API inside a container
# network (e.g. http://api:3001). Leave empty for local development.
API_INTERNAL_URL=

# --- API (NestJS) ------------------------------------------------------------
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000
# Cache TTL (seconds) for server-status responses.
SERVER_STATUS_CACHE_TTL_SECONDS=10

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=blackcinnamon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=blackcinnamon
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://blackcinnamon:change-me@localhost:5432/blackcinnamon

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Minecraft REST API (read path) -----------------------------------------
# Server-side only. Never expose to the browser.
MINECRAFT_REST_API_BASE_URL=http://127.0.0.1:8080
MINECRAFT_REST_API_TIMEOUT_MS=3000
MINECRAFT_REST_API_POLL_MS=10000

# --- Minecraft RCON (fulfilment path) ---------------------------------------
# Server-side only. Never expose to the browser.
MINECRAFT_RCON_HOST=127.0.0.1
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=change-me

# --- ToyyibPay (payment) -----------------------------------------------------
# Server-side only. Never expose to the browser.
TOYYIBPAY_ENV=sandbox
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_CALLBACK_URL=
TOYYIBPAY_RETURN_URL=

# --- Sessions / admin --------------------------------------------------------
ADMIN_SESSION_SECRET=change-me
DISCORD_CLIENT_SECRET=